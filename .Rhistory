x = "Tipo de publicación",
y = "Precio del libro")
df_publishers <- df %>%
mutate(Publisher = ifelse(is.na(Category), "Independent", "Editorial"))
ggplot(df_publishers, aes(x = reorder(publisher, Price, median), y = Price)) +
geom_boxplot(fill = "lightgreen") +
coord_flip() +
labs(title = "Distribución de precios por tipo de publicación",
x = "Tipo de publicación",
y = "Precio del libro")
